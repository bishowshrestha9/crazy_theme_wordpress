{
	"$schema": "https://raw.githubusercontent.com/WordPress/gutenberg/trunk/schemas/json/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "840px",
			"wideSize": "1240px"
		},
		"color": {
			"custom": true,
			"customDuotone": false,
			"customGradient": true,
			"defaultPalette": false,
			"palette": [
				{
					"name": "Sage Primary",
					"slug": "primary",
					"color": "#6FA692"
				},
				{
					"name": "Primary Hover",
					"slug": "primary-hover",
					"color": "#5D9380"
				},
				{
					"name": "Primary Tint",
					"slug": "primary-tint",
					"color": "#EEF5F1"
				},
				{
					"name": "Primary Light",
					"slug": "primary-light",
					"color": "#F4F9F6"
				},
				{
					"name": "Dark Noir",
					"slug": "dark",
					"color": "#080A0A"
				},
				{
					"name": "Card Background",
					"slug": "card-bg",
					"color": "#F7FAF8"
				},
				{
					"name": "Border",
					"slug": "border",
					"color": "#E5E9E7"
				},
				{
					"name": "Star Gold",
					"slug": "gold",
					"color": "#FFC107"
				},
				{
					"name": "Discount Red",
					"slug": "discount-red",
					"color": "#E53935"
				},
				{
					"name": "Pro Green",
					"slug": "pro-green",
					"color": "#2E7D32"
				},
				{
					"name": "Con Red",
					"slug": "con-red",
					"color": "#D32F2F"
				},
				{
					"name": "Text Main",
					"slug": "text-main",
					"color": "#19201D"
				},
				{
					"name": "Text Body",
					"slug": "text-body",
					"color": "#374151"
				},
				{
					"name": "White",
					"slug": "white",
					"color": "#FFFFFF"
				}
			]
		},
		"typography": {
			"customFontSize": true,
			"fontFamilies": [
				{
					"name": "Inter",
					"slug": "inter",
					"fontFamily": "'Inter', system-ui, -apple-system, 'Segoe UI', Arial, sans-serif"
				},
				{
					"name": "Montserrat",
					"slug": "montserrat",
					"fontFamily": "'Montserrat', system-ui, -apple-system, 'Segoe UI', Arial, sans-serif"
				}
			],
			"fontSizes": [
				{
					"name": "Small",
					"slug": "small",
					"size": "14px"
				},
				{
					"name": "Medium",
					"slug": "medium",
					"size": "16px"
				},
				{
					"name": "Body",
					"slug": "body",
					"size": "18px"
				},
				{
					"name": "Large",
					"slug": "large",
					"size": "24px"
				},
				{
					"name": "Heading 2",
					"slug": "heading-2",
					"size": "28px"
				},
				{
					"name": "Heading 1",
					"slug": "heading-1",
					"size": "40px"
				},
				{
					"name": "Display",
					"slug": "display",
					"size": "48px"
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"%",
				"vh",
				"vw"
			],
			"padding": true,
			"margin": true,
			"blockGap": true
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--text-body)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--inter)",
			"lineHeight": "1.8"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--montserrat)",
					"fontWeight": "600"
				},
				"color": {
					"text": "var(--wp--preset--color--text-main)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary-hover)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": {
					"radius": "8px"
				}
			}
		}
	}
}