    "newProductImageUrl": { "type": "string", "default": "" },
    "reviewAvatar1Id": { "type": "number", "default": 0 },
    "reviewAvatar1Url": { "type": "string", "default": "" },
    "reviewAvatar2Id": { "type": "number", "default": 0 },
    "reviewAvatar2Url": { "type": "string", "default": "" },
    "reviewAvatar3Id": { "type": "number", "default": 0 },
    "reviewAvatar3Url": { "type": "string", "default": "" },
    "feature1": { "type": "string", "default": "" },
    "feature2": { "type": "string", "default": "" },
    "feature3": { "type": "string", "default": "" },
