{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "version": "2.1.1",
  "name": "prosandcons/pros-and-cons",
  "title": "Pros and Cons Block Mag",
  "category": "widgets",
  "description": "Present product advantages and drawbacks with an easy-to-read layout.",
  "supports": {
    "multiple": true,
    "align": true
  },
  "keywords": [
    "Pros and Cons",
    "Pros",
    "Cons",
    "Review"
  ],
  "style": "file:./style-index.css",
  "editorStyle": "file:./style-index.css",
  "editorScript": "file:./index.js",
  "attributes": {
    "block_id": {
      "type": "string"
    },
    "prosListItems": {
      "type": "array",
      "default": []
    },
    "consListItems": {
      "type": "array",
      "default": []
    },
    "prosListContent": {
      "type": "string"
    },
    "consListContent": {
      "type": "string"
    },
    "layoutStyle": {
      "type": "string",
      "default": "layout-type-1"
    },
    "prosIconStatus": {
      "type": "boolean",
      "default": true
    },
    "consIconStatus": {
      "type": "boolean",
      "default": true
    },
    "prosTitle": {
      "type": "string",
      "default": "Pros"
    },
    "consTitle": {
      "type": "string",
      "default": "Cons"
    },
    "prosBgColor": {
      "type": "string",
      "default": "#24B644"
    },
    "consBgColor": {
      "type": "string",
      "default": "#F13A3A"
    },
    "prosTextColor": {
      "type": "string",
      "default": "#ffffff"
    },
    "consTextColor": {
      "type": "string",
      "default": "#ffffff"
    },
    "prosListBgColor": {
      "type": "string",
      "default": "#F5FFF8"
    },
    "consListBgColor": {
      "type": "string",
      "default": "#FFF5F5"
    },
    "prosIconColor": {
      "type": "string",
      "default": "#24B644"
    },
    "consIconColor": {
      "type": "string",
      "default": "#F13A3A"
    },
    "prosListType": {
      "type": "string",
      "default": "unordered",
      "enum": [ "ordered", "unordered" ]
    },
    "consListType": {
      "type": "string",
      "default": "unordered",
      "enum": [ "ordered", "unordered" ]
    },
    "prosUnorderedType": {
      "type": "string",
      "default": "icon",
      "enum": [ "icon", "bullet" ]
    },
    "consUnorderedType": {
      "type": "string",
      "default": "icon",
      "enum": [ "icon", "bullet" ]
    },
    "prosIconClass": {
      "type": "string",
      "default": "far fa-circle-check"
    },
    "consIconClass": {
      "type": "string",
      "default": "far fa-circle-xmark"
    },
    "prosContentType": {
      "type": "string",
      "default": "list"
    },
    "consContentType": {
      "type": "string",
      "default": "list"
    }
  }
}
